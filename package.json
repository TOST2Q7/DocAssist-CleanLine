{
  "name": "docassist-cleanline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:file": "tsc -b && vite build --mode file",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings",
    "deps": "depcruise src",
    "format": "prettier --write .",
    "check": "tsc -b && npm run lint && npm run deps && prettier --check . && vitest run"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/unbounded": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@iconify-json/solar": "^1.2.13",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "^18.7.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
